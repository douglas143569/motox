{
  "name": "motox",
  "version": "0.1.0",
  "private": true,
  "description": "MotoX - contratação de motoboys sob demanda, estilo Uber",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "apps": "node scripts/montar-apps.js",
    "android:cliente": "node scripts/montar-apps.js && cd apps/cliente && npx cap open android",
    "android:entregador": "node scripts/montar-apps.js && cd apps/entregador && npx cap open android",
    "exe": "node scripts/gerar-exe.js",
    "admin": "node scripts/trocar-admin.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "socket.io-client": "^4.8.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
